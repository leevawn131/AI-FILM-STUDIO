# AI Film Studio - Hybrid Edition
# Environment Configuration

# Optional: Google Gemini API Key
# If not provided, AI Film Studio seamlessly operates with its built-in
# Offline Studio Engine at zero cost.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage & Directory Paths
STUDIO_DATA_DIR=backend/data
IMPORT_WATCH_DIR=backend/data/watched_import

# Database & Seeding
# Default is false. Set to true if you want initial demo project auto-seeded.
SEED_DEMO_DATA=false

# Security & CORS (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=500
MAX_IMAGE_UPLOAD_SIZE_MB=25

# Filmmaking Defaults
DEFAULT_FPS=24
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_PROJECT_BUDGET=100.0
