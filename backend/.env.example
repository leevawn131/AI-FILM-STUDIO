# AI Film Studio - Local Web Application with Google Cloud AI Ecosystem
# Environment Configuration

# Primary AI Provider: Google Cloud Gemini
AI_PROVIDER=gemini

# Google Cloud AI Configuration (Required for cloud intelligence)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# Google Generative Media Models
GOOGLE_IMAGE_MODEL=imagen-3.0-generate-002
GOOGLE_VIDEO_MODEL=veo-2.0-generate-001

# Optional: Google Drive Cloud Backup & Sync
# Set to true and provide credentials path to enable optional Drive backup/sync
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS_FILE=

# Optional: Local Fallback Provider (Ollama)
# Disabled by default. Only enable if you want local LLM fallback when Gemini is offline.
OLLAMA_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=90

# Local Storage & Directory Paths
STUDIO_DATA_DIR=backend/data
IMPORT_WATCH_DIR=backend/data/watched_import

# Database & Seeding
SEED_DEMO_DATA=false

# Security & Local CORS (Only 127.0.0.1 / localhost)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_SIZE_MB=500
MAX_IMAGE_UPLOAD_SIZE_MB=25

# Filmmaking Defaults & Budgeting
DEFAULT_FPS=24
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_PROJECT_BUDGET=100.0
BUDGET_WARNING_THRESHOLD=0.8
